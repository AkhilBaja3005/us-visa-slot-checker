{
  "manifest_version": 3,
  "name": "US Visa Autofill Assistant",
  "version": "1.0.0",
  "description": "Autofills login credentials and security questions for US Visa Scheduling.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.usvisascheduling.com/*",
        "https://atlasauth.b2clogin.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
